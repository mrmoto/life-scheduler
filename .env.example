# =============================================================================
# Life Scheduler - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update with your values
# NEVER commit .env to Git (it's in .gitignore)

# Database Configuration
DATABASE_URL=postgresql://lifescheduler_user:changeme_secure_password@db:5432/lifescheduler
POSTGRES_DB=lifescheduler
POSTGRES_USER=lifescheduler_user
POSTGRES_PASSWORD=changeme_secure_password

# Flask Configuration
FLASK_APP=app/app.py
FLASK_ENV=development
SECRET_KEY=changeme_secret_key_min_32_chars_random_string

# App Configuration
DEBUG=1

